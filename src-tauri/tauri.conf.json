{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FunctionFly Vault",
  "version": "1.0.2",
  "identifier": "app.functionfly.vault",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5184",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "FunctionFly Vault",
        "label": "main",
        "width": 1280,
        "height": 820,
        "minWidth": 880,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "img-src": "'self' data:",
        "font-src": "'self' data:",
        "style-src": "'self' 'unsafe-inline'",
        "script-src": "'self'",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-ancestors": "'none'"
      },
      "capabilities": ["default"]
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQyNzI5RjgzQkY3NDgwMUYKUldRZmdIUy9nNTl5MHM2c2RwcU5nY3p5S3ZCWGNzODdRYzcyNXNXKzdxaVVBejg4Vy9SdFBFdkIK",
      "endpoints": [],
      "requireSignedVersion": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "copyright": "Copyright © 2026 FunctionFly",
    "shortDescription": "Zero-knowledge secrets vault for FunctionFly tenants.",
    "longDescription": "FunctionFly Vault is a cross-platform desktop client for the FunctionFly zero-knowledge secrets API. Decryption happens locally; the orchestrator never sees plaintext secrets.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "macOS": {
      "entitlements": "entitlements.plist",
      "hardenedRuntime": true,
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com"
    }
  }
}
