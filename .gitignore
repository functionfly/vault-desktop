# Build artefacts
node_modules/
dist/
target/
*.tsbuildinfo
bun.lockb
Cargo.lock.bak
.installed-deps

# Tauri runtime artefacts (e.g. cached `tauri info` lookups)
.tauri/

# Generated icons (regenerate via `python3.12 scripts/generate-icons.py`)
src-tauri/icons/.cache/

# Editor / OS noise
.DS_Store
.idea/
.vscode/
*.swp
*.swo
Thumbs.db

# Local env / secrets — never commit these
.env
.env.local
*.token
*.key
*.log
logs/

# The internal-identifier blocklist used by
# `scripts/check-no-internal-leaks.sh`. It lists the exact strings that
# must never be published, so committing it would publish them. The
# guard reads it from the working tree on the build host; CI injects it
# from a repository secret.
.internal-identifiers.local
internal-identifiers.txt

# Git bundles. A bundle carries the ENTIRE history of whatever it was
# made from — including any commit that was later rewritten away. One
# of these in the tree is a full copy of everything the repository has
# ever held, so it must never be committed.
*.bundle

# Release artefacts that the pipeline writes into the working tree.
# `release.yml` renders the release body here before uploading it.
release-notes.md

# Generated evidence / smoke run logs
artifacts/
/tmp/
captures/

# Coverage / test outputs
coverage/
**/coverage/
*.lcov
Cargo.target.parallel-incremental

# Python bytecode caches. The release helpers under scripts/release/ are
# Python, so importing them (or `py_compile`-ing them in the CI gate
# set) writes a __pycache__ next to the source. Those are build
# artefacts, not source.
__pycache__/
*.py[cod]

# macOS junk
*.dmg.tmp
